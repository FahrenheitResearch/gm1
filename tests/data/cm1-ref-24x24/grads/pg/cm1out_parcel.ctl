dset ^cm1out_pdata.dat                                                                                                        
title CM1 parcel data output, using version cm1r21.1; time is generic, see variable mtime for actual times
undef  -999999.9
xdef      36000 linear 1 1
ydef          1 linear 0 1
zdef          1 linear 0 1
tdef          2 linear 00:00Z01JAN0001 1YR
vars     28
x            1 99 x position                               (m)             
y            1 99 y position                               (m)             
z            1 99 z position (above sea level)             (m)             
u            1 99 u velocity                               (m/s)           
v            1 99 v velocity                               (m/s)           
w            1 99 w velocity                               (m/s)           
mtime        1 99 model time (seconds since beginning of s (s)             
th           1 99 potential temperature                    (K)             
t            1 99 temperature                              (K)             
prs          1 99 pressure                                 (Pa)            
qv           1 99 water vapor mixing ratio                 (kg/kg)         
qc           1 99 qc                                       (kg/kg)         
qr           1 99 qr                                       (kg/kg)         
qi           1 99 qi                                       (kg/kg)         
qs           1 99 qs                                       (kg/kg)         
qg           1 99 qg                                       (kg/kg)         
nci          1 99 nci                                      (1/kg)          
ncs          1 99 ncs                                      (1/kg)          
ncr          1 99 ncr                                      (1/kg)          
ncg          1 99 ncg                                      (1/kg)          
tke          1 99 subgrid tke                              (m^2/s^2)       
dbz          1 99 reflectivity                             (dBZ)           
b            1 99 buoyancy                                 (m/s/s)         
vpg          1 99 vertical perturbation pressure gradient  (m/s/s)         
zvort        1 99 vertical vorticity                       (1/s)           
rho          1 99 dry-air density                          (kg/m^3)        
qsl          1 99 saturation mixing ratio wrt liquid       (kg/kg)         
qsi          1 99 saturation mixing ratio wrt ice          (kg/kg)         
endvars
