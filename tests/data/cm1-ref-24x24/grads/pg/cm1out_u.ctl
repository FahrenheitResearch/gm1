dset ^cm1out_00%y4_u.dat                                                                                                      
options template
title CM1 output, using version cm1r21.1; units of x,y,z are km; time is generic, see cm1out_metadata for actual times
undef  -999999.9
xdef    121 linear  -6.000000E+01   1.000000E+00
ydef    120 linear  -5.950000E+01   1.000000E+00
zdef     40 linear   2.500000E-01   5.000000E-01
tdef          2 linear 00:00Z01JAN0001 1YR
vars      1
u                40 99 E-W (x) velocity (grid-relative)                             (m/s)       
endvars
