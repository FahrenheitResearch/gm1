dset ^cm1out_00%y4_u.dat                                                                                                      
options template
title CM1 output, using version cm1r21.1; units of x,y,z are meters; time is generic, see cm1out_metadata for actual times
undef  -999999.9
xdef     25 linear   0.000000E+00   1.000000E+03
ydef     24 linear   5.000000E+02   1.000000E+03
zdef     40 linear   2.500000E+02   5.000000E+02
tdef          2 linear 00:00Z01JAN0001 1YR
vars      1
u                40 99 E-W (x) velocity (grid-relative)                             (m/s)       
endvars
