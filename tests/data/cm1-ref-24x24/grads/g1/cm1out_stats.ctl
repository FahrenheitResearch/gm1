dset ^cm1out_stats.dat                                                                                                        
title CM1 stats output, using version cm1r21.1; time is generic, see variable mtime for actual times
undef  -999999.9
xdef 1 linear 0 1
ydef 1 linear 0 1
zdef 1 linear 0 1
tdef          3 linear 00:00Z01JAN0001 1YR
vars    142
mtime        1 99 model time (seconds since beginning of s (s)             
wmax         1 99 max vertical velocity                    (m/s)           
wmin         1 99 min vertical velocity                    (m/s)           
zwmax        1 99 level of max vertical velocity           (m AGL)         
zwmin        1 99 level of min vertical velocity           (m AGL)         
wmax500      1 99 max vertical velocity at 500 m AGL       (m/s)           
wmin500      1 99 min vertical velocity at 500 m AGL       (m/s)           
wmax1000     1 99 max vertical velocity at 1000 m AGL      (m/s)           
wmin1000     1 99 min vertical velocity at 1000 m AGL      (m/s)           
wmax2500     1 99 max vertical velocity at 2500 m AGL      (m/s)           
wmin2500     1 99 min vertical velocity at 2500 m AGL      (m/s)           
wmax5000     1 99 max vertical velocity at 5000 m AGL      (m/s)           
wmin5000     1 99 min vertical velocity at 5000 m AGL      (m/s)           
wmax10k      1 99 max vertical velocity at 10 km AGL       (m/s)           
wmin10k      1 99 min vertical velocity at 10 km AGL       (m/s)           
umax         1 99 max u velocity (grid-rel)                (m/s)           
umin         1 99 min u velocity (grid-rel)                (m/s)           
sumax        1 99 max u velocity at lowst mod lev (grid-re (m/s)           
sumin        1 99 min u velocity at lowst mod lev (grid-re (m/s)           
vmax         1 99 max v velocity (grid-rel)                (m/s)           
vmin         1 99 min v velocity (grid-rel)                (m/s)           
svmax        1 99 max v velocity at lowst mod lev (grid-re (m/s)           
svmin        1 99 min v velocity at lowst mod lev (grid-re (m/s)           
ppimax       1 99 max nondimensional pressure perturbation (nondimensional)
ppimin       1 99 min nondimensional pressure perturbation (nondimensional)
ppmax        1 99 max pressure perturbation                (Pa)            
ppmin        1 99 min pressure perturbation                (Pa)            
thpmax       1 99 max potential temperature perturbation   (K)             
thpmin       1 99 min potential temperature perturbation   (K)             
sthpmax      1 99 max pot. temp. pert. at lowest model lev (K)             
sthpmin      1 99 min pot. temp. pert. at lowest model lev (K)             
maxqv        1 99 max qv                                   (kg/kg)         
minqv        1 99 min qv                                   (kg/kg)         
maxqc        1 99 max qc                                   (kg/kg)         
minqc        1 99 min qc                                   (kg/kg)         
maxqr        1 99 max qr                                   (kg/kg)         
minqr        1 99 min qr                                   (kg/kg)         
maxqi        1 99 max qi                                   (kg/kg)         
minqi        1 99 min qi                                   (kg/kg)         
maxqs        1 99 max qs                                   (kg/kg)         
minqs        1 99 min qs                                   (kg/kg)         
maxqg        1 99 max qg                                   (kg/kg)         
minqg        1 99 min qg                                   (kg/kg)         
maxnci       1 99 max nci                                  (#/kg)          
minnci       1 99 min nci                                  (#/kg)          
maxncs       1 99 max ncs                                  (#/kg)          
minncs       1 99 min ncs                                  (#/kg)          
maxncr       1 99 max ncr                                  (#/kg)          
minncr       1 99 min ncr                                  (#/kg)          
maxncg       1 99 max ncg                                  (#/kg)          
minncg       1 99 min ncg                                  (#/kg)          
pratemax     1 99 maximum surface precipitation rate       (kg/m2/s)       
pratemin     1 99 minimum surface precipitation rate       (kg/m2/s)       
tkemax       1 99 max subgrid tke                          (m^2/s^2)       
tkemin       1 99 min subgrid tke                          (m^2/s^2)       
kmhmax       1 99 max horiz eddy viscosity for momentum    (m^2/s)         
kmhmin       1 99 min horiz eddy viscosity for momentum    (m^2/s)         
kmvmax       1 99 max vert eddy viscosity for momentum     (m^2/s)         
kmvmin       1 99 min vert eddy viscosity for momentum     (m^2/s)         
khhmax       1 99 max horiz eddy diffusivity for scalars   (m^2/s)         
khhmin       1 99 min horiz eddy diffusivity for scalars   (m^2/s)         
khvmax       1 99 max vert eddy diffusivity for scalars    (m^2/s)         
khvmin       1 99 min vert eddy diffusivity for scalars    (m^2/s)         
divmax       1 99 max 3d divergence                        (1/s)           
divmin       1 99 min 3d divergence                        (1/s)           
rhmax        1 99 max relative humidity wrt liquid         (nondimensional)
rhmin        1 99 min relative humidity wrt liquid         (nondimensional)
rhimax       1 99 min relative humidity wrt ice            (nondimensional)
rhimin       1 99 min relative humidity wrt ice            (nondimensional)
themax       1 99 max theta-e below 10 km                  (K)             
themin       1 99 min theta-e below 10 km                  (K)             
sthemax      1 99 max theta-e at lowest model level        (K)             
sthemin      1 99 min theta-e at lowest model level        (K)             
qctop        1 99 max cloud top height                     (m)             
qcbot        1 99 min cloud base height                    (m)             
sprsmax      1 99 max pressure at lowest model level       (Pa)            
sprsmin      1 99 min pressure at lowest model level       (Pa)            
psfcmax      1 99 max pressure at surface                  (Pa)            
psfcmin      1 99 min pressure at surface                  (Pa)            
wspmax       1 99 max grid-rel horiz wind speed            (m/s)           
wspmin       1 99 min grid-rel horiz wind speed            (m/s)           
zwspmax      1 99 level of max grid-rel horiz wind speed   (m AGL)         
zwspmin      1 99 level of min grid-rel horiz wind speed   (m AGL)         
swspmax      1 99 max grid-rel horiz wind speed at l.m.l.  (m/s)           
swspmin      1 99 min grid-rel horiz wind speed at l.m.l.  (m/s)           
cflmax       1 99 max Courant number                       (nondimensional)
kshmax       1 99 max horiz K stability factor             (nondimensional)
ksvmax       1 99 max vert K stability factor              (nondimensional)
vortsfc      1 99 max vert vorticity at lowest model level (1/s)           
vort1km      1 99 max vert vorticity at 1 km AGL           (1/s)           
vort2km      1 99 max vert vorticity at 2 km AGL           (1/s)           
vort3km      1 99 max vert vorticity at 3 km AGL           (1/s)           
vort4km      1 99 max vert vorticity at 4 km AGL           (1/s)           
vort5km      1 99 max vert vorticity at 5 km AGL           (1/s)           
tmass        1 99 total mass of dry air                    (kg)            
tmois        1 99 total mass of moisture                   (kg)            
massqv       1 99 total mass of qv                         (kg)            
massqc       1 99 total mass of qc                         (kg)            
massqr       1 99 total mass of qr                         (kg)            
massqi       1 99 total mass of qi                         (kg)            
massqs       1 99 total mass of qs                         (kg)            
massqg       1 99 total mass of qg                         (kg)            
ek           1 99 total kinetic energy                     (kg m^2/s^2)    
ei           1 99 total internal energy                    (kg m^2/s^2)    
ep           1 99 total potential energy                   (kg m^2/s^2)    
le           1 99 total latent energy                      (kg m^2/s^2)    
et           1 99 total energy                             (kg m^2/s^2)    
tmu          1 99 total E-W momentum                       (kg m/s)        
tmv          1 99 total N-S momentum                       (kg m/s)        
tmw          1 99 total vertical momentum                  (kg m/s)        
tmfu         1 99 total upward dry-air mass flux           (kg m/s)        
tmfd         1 99 total downward dry-air mass flux         (kg m/s)        
tcond        1 99 tcond                                    (unk)           
tevac        1 99 tevac                                    (unk)           
tauto        1 99 tauto                                    (unk)           
taccr        1 99 taccr                                    (unk)           
tevar        1 99 tevar                                    (unk)           
train        1 99 train                                    (unk)           
erain        1 99 erain                                    (unk)           
qsfc         1 99 qsfc                                     (unk)           
esfc         1 99 esfc                                     (unk)           
erad         1 99 erad                                     (unk)           
asqv         1 99 artificial source of qv                  (kg)            
asqc         1 99 artificial source of qc                  (kg)            
asqr         1 99 artificial source of qr                  (kg)            
asqi         1 99 artificial source of qi                  (kg)            
asqs         1 99 artificial source of qs                  (kg)            
asqg         1 99 artificial source of qg                  (kg)            
asnci        1 99 artificial source of nci                 (kg)            
asncs        1 99 artificial source of ncs                 (kg)            
asncr        1 99 artificial source of ncr                 (kg)            
asncg        1 99 artificial source of ncg                 (kg)            
bsqv         1 99 bndry source/sink of qv                  (kg)            
bsqc         1 99 bndry source/sink of qc                  (kg)            
bsqr         1 99 bndry source/sink of qr                  (kg)            
bsqi         1 99 bndry source/sink of qi                  (kg)            
bsqs         1 99 bndry source/sink of qs                  (kg)            
bsqg         1 99 bndry source/sink of qg                  (kg)            
bsnci        1 99 bndry source/sink of nci                 (kg)            
bsncs        1 99 bndry source/sink of ncs                 (kg)            
bsncr        1 99 bndry source/sink of ncr                 (kg)            
bsncg        1 99 bndry source/sink of ncg                 (kg)            
endvars
