dset ^cm1out_metadata.dat
title CM1 metadata for 3d output files; using version cm1r21.1
undef  -999999.9
xdef 1 linear 0 1
ydef 1 linear 0 1
zdef 1 linear 0 1
tdef          2 linear 00:00Z01JAN0001 1YR
vars      4
mtime             0 99 model time (seconds since beginning of simulation)          
nstep             0 99 time steps (since beginning of simulation)                  
dt                0 99 current time step (seconds)                                 
nwrite            0 99 writeout number                                             
endvars
